# BMAD Configuration (tracked in git for team consistency)
# Only ignore runtime/temporary files, not configuration
.bmad-core/.DS_Store
.bmad-*/
.claude/commands/BMad/.DS_Store
web-bundles
AGENTS.md
.worktrees

# AI Debug and Runtime Files (local only)
.ai/debug-log.md
.ai/*.log
.ai/.DS_Store

# Runtime artifacts
node_modules/
dist/
build/
.vite/

# Python virtual environments
.venv/
venv/
env/

# Python cache
.pycache/
__pycache__/
*.pyc

# Environment files
.env
.env.*
server/.env
web/.env.local

# ESP-IDF build outputs
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old

# macOS / IDE cruft
.DS_Store

# Keep BMAD core config, agents, tasks, templates tracked
# !.bmad-core/
