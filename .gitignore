# BMAD Configuration (tracked in git for team consistency)
# Only ignore runtime/temporary files, not configuration
.bmad-core/.DS_Store
.bmad-*/
.claude/commands/BMad/.DS_Store
web-bundles
AGENTS.md
.worktrees

# AI Debug and Runtime Files (local only)
.ai/debug-log.md
.ai/*.log
.ai/.DS_Store

# Runtime artifacts
node_modules/
dist/
build/
.vite/

# Python virtual environments (catch at any depth)
**/.venv/
**/venv/
**/env/
.venv/
venv/
env/

# Python cache
.pycache/
__pycache__/
*.pyc

# Environment files
.env
.env.*
server/.env
server/.env.docker
web/.env.local

# SSH Keys (NEVER commit private keys!)
SSH_Key/
*.pem
*.key
id_rsa
id_ed25519
id_ecdsa
deploy_key
deploy_key.pub

# ESP-IDF build outputs
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old

# macOS / IDE cruft
.DS_Store

# Keep BMAD core config, agents, tasks, templates tracked
# !.bmad-core/
# !.bmad-core/**/*
*.backup/
