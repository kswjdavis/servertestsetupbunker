# Dockerfile for testing deployment scripts locally
# Simulates Ubuntu 24.04 DigitalOcean droplet

FROM ubuntu:24.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    sudo \
    python3 \
    python3-pip \
    python3-venv \
    postgresql \
    postgresql-contrib \
    nginx \
    systemctl \
    && rm -rf /var/lib/apt/lists/*

# Create bunkercolab user with sudo access (simulating production)
RUN useradd -m -s /bin/bash bunkercolab && \
    echo "bunkercolab ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Set up PostgreSQL to allow local connections
RUN service postgresql start && \
    su - postgres -c "psql -c \"CREATE USER bunkercolab_user WITH PASSWORD 'Bunker123';\"" && \
    su - postgres -c "psql -c \"CREATE DATABASE bunkercolab OWNER bunkercolab_user;\"" && \
    su - postgres -c "psql -c \"GRANT ALL PRIVILEGES ON DATABASE bunkercolab TO bunkercolab_user;\""

# Switch to bunkercolab user
USER bunkercolab
WORKDIR /home/bunkercolab

# Clone repository will be mounted as volume
# This allows us to test with the actual local codebase

CMD ["/bin/bash"]
