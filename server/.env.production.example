# =============================================================================
# Production environment configuration
# Copy to server/.env.production and update the values before deploying.
# =============================================================================

# Database connection string (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://bunkercolab_user:CHANGE_ME@localhost/bunkercolab

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_64_CHAR_HEX_STRING
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS origins allowed to access the API (comma-separated)
CORS_ORIGINS=https://bunkercolab.example.com

# Weather configuration
WEATHER_STATION_ID=KMSP
WEATHER_API_TIMEOUT_SECONDS=10
WEATHER_POLL_INTERVAL_SECONDS=60
WEATHER_STALE_THRESHOLD_MINUTES=10
WEATHER_USER_AGENT="BunkerColab/1.0 (ops@bunkercolab.example.com)"

# Runtime environment identifier
ENVIRONMENT=production
